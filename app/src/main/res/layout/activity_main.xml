<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- 左侧：泵型号多选面板 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_pump_models"
            android:textStyle="bold"
            android:padding="4dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/checkBoxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"/>
        </ScrollView>

        <!-- 数据信息 -->
        <TextView
            android:id="@+id/textDataInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_data_info"
            android:textSize="10sp"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- 右侧：图表 + 控制面板 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7"
        android:orientation="vertical">

        <!-- 控制面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_x_axis"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/editPressureMin"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:hint="@string/hint_pressure_min"
                android:inputType="numberDecimal"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/editPressureMax"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:hint="@string/hint_pressure_max"
                android:inputType="numberDecimal"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Torr"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>

            <CheckBox
                android:id="@+id/checkLogX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_log"
                android:textSize="12sp"
                android:checked="true"/>

            <Button
                android:id="@+id/btnPlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_plot"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_clear"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_export"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 图表区域 -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

</LinearLayout>
